#=================================================================================================#
##				Development's Environment Variables												 ##
#=================================================================================================#

### rust
export CARGO_HOME="$XDG_DATA_HOME"/cargo
export RUSTUP_HOME="$XDG_DATA_HOME"/rustup

### go
export GOPATH="$XDG_DATA_HOME"/go

### python
export PYTHONSTARTUP="$XDG_CONFIG_HOME"/python/pythonrc

### dotnet
export DOTNET_CLI_HOME="$XDG_DATA_HOME"/dotnet

### gnupg
export GNUPGHOME="$XDG_DATA_HOME"/gnupg

### npm
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME"/npm/npmrc
export NPM_CONFIG_PREFIX="$XDG_DATA_HOME"/npm

### bun
export BUN_INSTALL="$XDG_DATA_HOME"/bun
export BUN_INSTALL_GLOBAL_DIR="$BUN_INSTALL"/install/global
export BUN_INSTALL_BIN="$HOME"/.local/bin

### java
# mise keeps a stable symlink per major version, so these survive patch
# upgrades. Gradle reads them through org.gradle.java.installations.fromEnv
# (see ~/.local/share/gradle/gradle.properties) to satisfy jvmToolchain(N)
# without downloading its own JDKs.
export JAVA_HOME_17="$XDG_DATA_HOME/mise/installs/java/temurin-17"
export JAVA_HOME_21="$XDG_DATA_HOME/mise/installs/java/temurin-21"
# mise is activated from .zshrc and therefore absent in non-interactive
# shells, where Gradle would find no JVM. Setting JAVA_HOME here keeps
# ./gradlew working in CI and in scripts; mise overrides it once active.
export JAVA_HOME="$JAVA_HOME_21"

### android
# The Android SDK and the CLI's own state are kept under XDG_DATA_HOME rather
# than the vendor defaults (~/Android/Sdk and ~/.android). ANDROID_SDK_ROOT is
# deliberately not set: the android CLI ignores it and honours ANDROID_HOME.
export ANDROID_HOME="$XDG_DATA_HOME/android/sdk"
export ANDROID_USER_HOME="$XDG_DATA_HOME/android/user"
# The android CLI honours ANDROID_USER_HOME, but the emulator binary does
# not and looks up AVDs through ANDROID_AVD_HOME instead, so both are
# needed for `android emulator list` and `emulator -list-avds` to agree.
export ANDROID_AVD_HOME="$ANDROID_USER_HOME/avd"
export GRADLE_USER_HOME="$XDG_DATA_HOME/gradle"
