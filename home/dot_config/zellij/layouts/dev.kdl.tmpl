// .config/zellij/layouts/dev.kdl

layout {
  // Use the current dir when `zellij --layout dev`
  cwd ""

  pane size=1 borderless=true {
    plugin location="tab-bar"
  }

  pane split_direction="vertical" {
    // Left: File / Git (15%)
    pane size="15%" stacked=true {
      pane {
        name "File"
        close_on_exit true
        expanded true
        command {{ .zellijFileCommand | quote }}
      }
      pane {
        name "Git"
        close_on_exit true
        command {{ .zellijGitCommand | quote }}
      }
    }

    // Right: Editor / Agent / Terminal (85%)

    pane split_direction="horizontal" size="85%" {
      pane size="85%" stacked=true {

        pane focus=true {
          name "Editor"

          command "sh"
          args "-c" "exec \"${XDG_CONFIG_HOME:-$HOME/.config}/zellij/scripts/zellij-nvim-editor.sh\""
        }

        pane name="Agent"

        pane name="Terminal"
      }
    }
  }
  pane size=1 borderless=true {
    plugin location="status-bar"
  }
}
