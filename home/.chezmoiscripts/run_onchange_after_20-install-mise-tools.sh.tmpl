#!/bin/sh

set -eu

# Re-run when the global mise runtime manifest changes.
# mise config checksum: {{ include "dot_config/mise/config.toml" | sha256sum }}

if ! command -v mise >/dev/null 2>&1; then
  printf '%s\n' \
    'mise is not installed; skipping development runtime installation.' \
    'Install mise, then run: mise install'
  exit 0
fi

mise install --yes
